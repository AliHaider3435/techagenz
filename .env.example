# ═══════════════════════════════════════════════════════════════════════════════
# Tech Agenz — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════════
#
# VERCEL FRONTEND (root .env or Vercel dashboard)
# ────────────────────────────────────────────────────────────────────────────
# VITE_ prefix = safe to expose to browser bundle.
# Never put secrets in VITE_ variables.

# Public Cloudflare Turnstile site key (safe for browser)
VITE_CF_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here

# Base URL of the Cloudflare development Worker API
VITE_API_BASE_URL=https://api-dev.techagenz.com

# Admin-only API origin. Keep empty until the custom API hostname and its
# Cloudflare Access application/audience are verified. Never use workers.dev.
VITE_ADMIN_API_BASE_URL=

# ────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE WORKER (worker/.dev.vars for local dev, `wrangler secret put` for production)
# ────────────────────────────────────────────────────────────────────────────
# See worker/.dev.vars.example for the complete list of Worker secrets.
