# ═══════════════════════════════════════════════════════════════════════════════
# Tech Agenz — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════════
#
# FRONTEND (root .env or Vercel dashboard)
# ────────────────────────────────────────────────────────────────────────────
# VITE_ variables are public and embedded in the browser bundle.
# Never put passwords, API keys, tokens, or other secrets in VITE_ variables.

# Public Cloudflare Turnstile site key for browser widgets (not a secret).
VITE_CF_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here

# Development API origin used by website enquiry forms.
VITE_API_BASE_URL=https://api-dev.techagenz.com

# Development admin API origin (Cloudflare Access authentication).
VITE_ADMIN_API_BASE_URL=https://api-dev.techagenz.com

# Production deployment values (configure only in the production frontend):
# VITE_API_BASE_URL=https://api.techagenz.com
# VITE_ADMIN_API_BASE_URL=https://api.techagenz.com

# ────────────────────────────────────────────────────────────────────────────
# WORKER-ONLY SECRETS
# ────────────────────────────────────────────────────────────────────────────
# Keep these out of the frontend .env file. Use worker/.dev.vars for local-only
# development and Cloudflare Worker secrets for deployed environments.
# Examples: CF_TURNSTILE_SECRET_KEY, ADMIN_SHARED_USERNAME,
# ADMIN_SHARED_PASSWORD_HASH, and RESEND_API_KEY.
